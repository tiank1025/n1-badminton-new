# ── Mail (optional) ──────────────────────────────────────
# Leave blank and the app keeps working — only email stays silent. Currently
# email is sent when a waitlisted player is promoted (automatic or by admin).
# SMTP_HOST/SMTP_USER/SMTP_PASS are required to actually send mail.
# For Gmail, turn on 2-Step Verification and create an App Password
# (https://myaccount.google.com/apppasswords), then paste that 16-char
# code into SMTP_PASS — NOT your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teamn1badm@gmail.com
SMTP_PASS=
SMTP_FROM=N1 Badminton <teamn1badm@gmail.com>

# ── Public URL (used when generating mobile check-in QR codes) ────
# Leave unset on localhost; set to your real domain in production so
# the QR code points at the correct URL.
# PUBLIC_BASE_URL=https://n1badminton.org
